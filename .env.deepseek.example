# DeepSeek settings for cheaper OpenAI-compatible persona generation.
# Copy these lines into your real .env and set DEEPSEEK_API_KEY.

AI_PROVIDER=deepseek
CHAT_LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Keep these only if you want quick switching back to OpenAI later.
# AI_PROVIDER=openai
# CHAT_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o
