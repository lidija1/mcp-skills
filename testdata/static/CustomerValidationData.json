{
  "testCases": [
    {
      "TC_ID": "TC_INVALID_EMAIL_NO_AT",
      "Description": "Email without @ symbol should show validation error",
      "CustomerType": "Individual",
      "FirstName": "John",
      "LastName": "Doe",
      "DOB": "01/15/1990",
      "PhoneNum": "555-123-4567",
      "Email": "johndoeemail.com",
      "Address": "123 Main Street",
      "ZIP": "01101",
      "ExpectedValidationError": "The email address \"johndoeemail.com\" is wrong. An email address can include letters or numbers and must have an @. Multiple emails are separated by a semi colon, for example user123@example.com;user321@example.com.",
      "ValidationType": "EMAIL"
    },
    {
      "TC_ID": "TC_INVALID_EMAIL_NO_USER",
