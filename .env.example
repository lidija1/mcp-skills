# Copy this file to .env and fill in local values.
# Do not commit your real .env file.

# OneShield login
PARTNER_NUM=0
USERNAMEE=your_username
PASSWORD=your_password

# Optional browser/control flags used by local tools.
LOB_HEADLESS=false

# Optional AI provider settings for MCP persona/policy generation.
# Set AI_PROVIDER only when you want to force a provider.
# AI_PROVIDER=openai
# AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional allowlist for form-intelligence probing tools.
# Comma-separated origins only, no wildcards.
# Example: https://inforcedev.oneshield.com
PROBE_ALLOWED_ORIGINS=
